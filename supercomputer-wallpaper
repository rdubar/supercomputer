#!/usr/bin/env python3
"""Render a retro mainframe front-panel wallpaper (1920x1080 by default).

  supercomputer-wallpaper [OUTPUT.png] [WIDTH HEIGHT]
"""
import math
import os
import random
import sys

from PIL import Image, ImageDraw, ImageFilter, ImageFont

OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser(
    "~/Pictures/wallpapers/supercomputer-1920x1080.png")
W, H = (int(sys.argv[2]), int(sys.argv[3])) if len(sys.argv) > 3 else (1920, 1080)
S = W / 1920  # scale factor
HOST = os.uname().nodename.upper()

FONT_DIR = "/usr/share/fonts/truetype/dejavu/"
def font(size, bold=False):
    name = "DejaVuSansMono-Bold.ttf" if bold else "DejaVuSansMono.ttf"
    return ImageFont.truetype(FONT_DIR + name, int(size * S))

AMBER = (255, 140, 0)
AMBER_DIM = (60, 32, 6)
CREAM = (232, 220, 190)
LABEL = (190, 170, 130)
RULE = (120, 96, 60)
random.seed(1975)

img = Image.new("RGB", (W, H))
d = ImageDraw.Draw(img)

# Background: vertical gradient, warm charcoal
for y in range(H):
    t = y / H
    c = int(22 + 10 * math.sin(t * math.pi))
    d.line([(0, y), (W, y)], fill=(c + 4, c + 2, c))
# brushed-metal grain
noise = Image.effect_noise((W, H), 18).convert("RGB")
img = Image.blend(img, noise, 0.04)
d = ImageDraw.Draw(img)

glow = Image.new("RGB", (W, H))
g = ImageDraw.Draw(glow)


def px(v):
    return int(v * S)


def lamp(x, y, r, on, color=AMBER):
    if on:
        g.ellipse([x - r * 2.6, y - r * 2.6, x + r * 2.6, y + r * 2.6], fill=tuple(int(c * 0.38) for c in color))
        d.ellipse([x - r, y - r, x + r, y + r], fill=color)
        d.ellipse([x - r * 0.45, y - r * 0.55, x + r * 0.1, y - r * 0.1], fill=(255, 225, 170))
    else:
        d.ellipse([x - r, y - r, x + r, y + r], fill=AMBER_DIM, outline=(40, 26, 8))


def toggle(x, y, color, up):
    w, h = px(16), px(46)
    d.rounded_rectangle([x - w / 2, y, x + w / 2, y + h], radius=px(4), fill=color, outline=(20, 18, 16))
    mark = y + px(6) if up else y + h - px(14)
    d.rectangle([x - w / 2 + px(3), mark, x + w / 2 - px(3), mark + px(8)], fill=tuple(max(0, c - 60) for c in color))


def text(x, y, s, size, fill=LABEL, bold=False, anchor="la"):
    d.text((x, y), s, font=font(size, bold), fill=fill, anchor=anchor)


# ---------------------------------------------------------------- frame
margin = px(90)
top = px(120)  # leave room for the panel bar and desktop icons
d.rectangle([margin, top, W - margin, H - px(70)], outline=RULE, width=px(3))
d.rectangle([margin + px(10), top + px(10), W - margin - px(10), H - px(80)], outline=(60, 48, 32), width=px(1))

# Nameplate
text(W / 2, top + px(55), f"{HOST}  ·  BCM2712 VECTOR PROCESSING SYSTEM", 42, CREAM, True, "mm")
text(W / 2, top + px(100), "MODEL 5  ·  4 CENTRAL PROCESSORS  ·  8192 KW CORE  ·  SERIAL 2CCF678D90D0", 18, LABEL, False, "mm")
d.line([(margin + px(60), top + px(128)), (W - margin - px(60), top + px(128))], fill=RULE, width=px(2))

# ---------------------------------------------------------------- registers
registers = ["PROGRAM COUNTER", "MEMORY ADDRESS", "MEMORY BUFFER", "ACCUMULATOR", "INSTRUCTION"]
bits = 24
x0 = margin + px(320)
spacing = px(40)
row_y = top + px(190)
for ri, name in enumerate(registers):
    y = row_y + ri * px(62)
    text(x0 - px(40), y, name, 20, LABEL, True, "rm")
    for b in range(bits):
        x = x0 + b * spacing + (b // 3) * px(14)
        lamp(x, y, px(11), random.random() < 0.45)
    # bit numbers under first row
    if ri == 0:
        for b in range(bits):
            x = x0 + b * spacing + (b // 3) * px(14)
            text(x, y - px(30), f"{bits - 1 - b:02d}", 12, RULE, False, "mm")

# octal group shading lines
last_x = x0 + (bits - 1) * spacing + ((bits - 1) // 3) * px(14)

# Switch register
sw_y = row_y + len(registers) * px(62) - px(10)
text(x0 - px(40), sw_y + px(23), "SWITCH REGISTER", 20, LABEL, True, "rm")
for b in range(bits):
    x = x0 + b * spacing + (b // 3) * px(14)
    color = (214, 120, 40) if (b // 3) % 2 == 0 else (224, 214, 190)
    toggle(x, sw_y, color, random.random() < 0.3)

# Control switches
ctl_y = sw_y + px(82)
controls = ["START", "LOAD", "DEP", "EXAM", "CONT", "HALT", "STEP", "BOOT"]
for i, name in enumerate(controls):
    x = x0 + i * px(120) + px(30)
    toggle(x, ctl_y, (170, 40, 30) if name in ("HALT", "BOOT") else (224, 214, 190), False)
    text(x, ctl_y + px(66), name, 15, LABEL, True, "mm")

# ---------------------------------------------------------------- status column
sx = W - margin - px(250)
sy = row_y - px(10)
text(sx, sy - px(30), "SYSTEM STATUS", 20, CREAM, True)
statuses = [("POWER", True, (90, 230, 90)), ("RUN", True, AMBER), ("HALT", False, (240, 60, 40)),
            ("PARITY", False, (240, 60, 40)), ("COOLANT", True, (80, 200, 255)), ("VECTOR", True, AMBER),
            ("I/O BUSY", True, AMBER), ("OPERATOR", False, AMBER)]
for i, (name, on, col) in enumerate(statuses):
    y = sy + px(20) + i * px(44)
    lamp(sx + px(14), y, px(10), on, col)
    text(sx + px(42), y, name, 18, LABEL, True, "lm")

# ---------------------------------------------------------------- tape drives
tape_y = ctl_y + px(105)
units = ["SYS", "MED1", "MED2", "MED3", "MED4"]
unit_w = px(270)
tx0 = W / 2 - (len(units) * unit_w) / 2
for i, name in enumerate(units):
    ux = tx0 + i * unit_w
    d.rounded_rectangle([ux + px(10), tape_y, ux + unit_w - px(10), tape_y + px(150)],
                        radius=px(8), fill=(16, 14, 12), outline=RULE, width=px(2))
    for k, cx in enumerate((ux + px(80), ux + unit_w - px(80))):
        cy = tape_y + px(66)
        r = px(46)
        d.ellipse([cx - r, cy - r, cx + r, cy + r], fill=(38, 34, 30), outline=(110, 100, 86), width=px(2))
        tape_r = r * (0.85 if (k + i) % 2 == 0 else 0.55)
        d.ellipse([cx - tape_r, cy - tape_r, cx + tape_r, cy + tape_r], fill=(60, 40, 22))
        for a in range(3):
            ang = a * 2 * math.pi / 3 + i
            d.line([(cx, cy), (cx + math.cos(ang) * r * 0.9, cy + math.sin(ang) * r * 0.9)],
                   fill=(110, 100, 86), width=px(4))
        d.ellipse([cx - px(8), cy - px(8), cx + px(8), cy + px(8)], fill=(150, 140, 120))
    text(ux + unit_w / 2, tape_y + px(132), f"STORAGE UNIT {name}", 15, LABEL, True, "mm")
    lamp(ux + unit_w - px(28), tape_y + px(132), px(6), i != 2)

# Footer
text(margin + px(20), H - px(100), "VECTOR PROCESSING DIVISION  ·  CORE MEMORY ONLINE", 14, RULE)
text(W - margin - px(20), H - px(100), "OPERATOR CONSOLE: TYPE 'supercomputer'", 14, RULE, False, "ra")

# ---------------------------------------------------------------- finish
glow = glow.filter(ImageFilter.GaussianBlur(px(9)))
img = Image.composite(img, img, Image.new("L", (W, H), 255))
from PIL import ImageChops
img = ImageChops.add(img, glow)
# CRT-ish scanlines + vignette
over = Image.new("L", (W, H), 0)
o = ImageDraw.Draw(over)
for y in range(0, H, 3):
    o.line([(0, y), (W, y)], fill=22)
img = Image.composite(Image.new("RGB", (W, H)), img, over)
vig = Image.radial_gradient("L").resize((W, H)).point(lambda v: int(v * 0.55))
img = Image.composite(Image.new("RGB", (W, H)), img, vig)

os.makedirs(os.path.dirname(OUT), exist_ok=True)
img.save(OUT, optimize=True)
print(OUT)
